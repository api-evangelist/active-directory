                "description": "Service principal object ID"
              }
            ]
          },
          "docs": "Retrieve the properties of a service principal by its object ID."
        },
        {
          "info": {
            "name": "Active Directory List Service Principal App Role Assignments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/servicePrincipals/:servicePrincipalId/appRoleAssignments",
            "params": [
              {
                "name": "servicePrincipalId",
                "value": "",
                "type": "path"
              }
