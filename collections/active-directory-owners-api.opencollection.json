{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Graph Applications and Service Principals App Role Assignments Owners API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Owners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Active Directory List Group Owners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/groups/:groupId/owners",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group object ID (UUID)"
              }
            ]
          },
          "docs": "Get the owners of a group. Owners are non-admin users who can manage the group without being assigned a directory role. Microsoft 365 groups must have at least one owner."
        }
      ]
    }
  ],
  "bundled": true
}